# Overwatch Environment Variables
#
# RECOMMENDED: For a full deployment, run:
#   overwatch init
#
# The wizard generates deployment-specific .env files. For local/manual use,
# copy this file to .env and fill in only the variables your overwatch.yaml
# and app definitions reference.
#
# This file lists ALL possible variables for reference.

# Required: JWT secret for admin authentication
JWT_SECRET=replace-with-at-least-32-random-characters

# Required: Google OAuth for admin login
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Database root credentials (based on your database type in overwatch.yaml)
# For MySQL/MariaDB:
MYSQL_ROOT_PASSWORD=your-mysql-root-password
# For PostgreSQL:
# POSTGRES_PASSWORD=your-postgres-password

# Container Registry credentials (based on your registry type in overwatch.yaml)
# For GitHub Container Registry:
GHCR_TOKEN=ghp_your_github_token
# For GitLab Container Registry:
# GITLAB_TOKEN=glpat_your_gitlab_token
# For Docker Hub:
# DOCKER_USERNAME=your-dockerhub-username
# DOCKER_PASSWORD=your-dockerhub-password
# For AWS ECR:
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1

# Initial admin emails (comma-separated, used on first launch)
# ALLOWED_ADMIN_EMAILS=admin@example.com,other@example.com

# Server port (default: 3002)
# PORT=3002
# Trust proxy setting for Express req.ip handling behind Traefik (default: 1)
# OVERWATCH_TRUST_PROXY=1
# Allow private-network registry/API URLs for intentional self-hosted setups
# OVERWATCH_ALLOW_PRIVATE_REGISTRY_URL=1

# Backup credentials (for Restic with S3-compatible storage)
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# R2_BUCKET_NAME=your-bucket-name
# R2_ACCESS_KEY_ID=your-r2-access-key
# R2_SECRET_ACCESS_KEY=your-r2-secret-key
# RESTIC_PASSWORD=your-restic-password

# Admin access token secret (optional, for direct tenant app access)
# AUTH_SERVICE_SECRET=your-admin-access-secret
